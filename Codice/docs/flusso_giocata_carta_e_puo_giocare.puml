@startuml
title UNO Legends - Giocata carta e richiesta di input dell'effetto

|Utente|
start
:Sceglie l'opzione "gioca carta";

|UnoLegendsCli|
:Raccoglie indice e dichiarazione UNO;
:Invoca UnoLegendsGame.giocaCarta(indice, null, unoDichiarato);

|UnoLegendsGame|
:Inoltra il tentativo a Partita;

|Partita|
:Verifica partita, carta in mano e regola della carta appena pescata;
:Verifica la compatibilità della carta;

if (Mossa non valida?) then (si)
  :Restituisce EsitoGiocata senza richiesta;
  |UnoLegendsCli|
  :Mostra "Mossa non valida";
  stop
endif

:Invoca carta.getEffetto().getRichiestaInput();

if (L'effetto richiede un input?) then (si)
  :Restituisce EsitoGiocata.inAttesa(RichiestaInput);
  |UnoLegendsGame|
  :Inoltra la richiesta alla UI;
  |UnoLegendsCli|
  :Mostra messaggio e opzioni senza identificare l'effetto;
  :Raccoglie la risposta;
  :Invoca giocaCarta(indice, risposta, unoDichiarato);
  |UnoLegendsGame|
  :Inoltra il tentativo con la risposta;
  |Partita|
  :Invoca effetto.validaRispostaInput(risposta);
  if (Risposta valida?) then (no)
    :Restituisce la stessa richiesta;
    |UnoLegendsCli|
    :Mostra nuovamente la richiesta;
    stop
  endif
endif

|Partita|
:Invoca Giocatore.estraiCarta(indice);
:Invoca PilaDegliScarti.aggiungiCarta(carta);
:Invoca carta.getEffetto().attivaeffetto(this, risposta);
:Applica la penalità UNO se necessaria;
:Verifica la condizione di vittoria;
:Aggiorna il giocatore attivo se la partita continua;
:Restituisce EsitoGiocata.completata(true);

|UnoLegendsGame|
:Restituisce l'esito;

|UnoLegendsCli|
:Mostra "Carta giocata";
stop
@enduml
