    +getPilaDegliScarti() : PilaDegliScarti
    +prelevaEventi() : List<EventoPartita>
    ~registraEvento(evento : EventoPartita) : void
    +giocaCarta(indiceCarta : int) : boolean
    +rispondiInput(risposta : String) : boolean
    +completaDichiarazioneUno(unoDichiarato : boolean) : boolean
    ~applicaColoreScelto(coloreScelto : Colore) : void
    +getColoreAttuale() : Colore
    ~segnalaSaltoTurno() : void
    +pescaCarta() : boolean
    +pescaSingola(giocatore : Giocatore) : Carta
    +applicaPescaForzata(bersaglio : Giocatore, numeroCarte : int, origine : OriginePesca) : List<Carta>
    +passaTurno() : boolean
    +cambioGiro() : void
    +getProssimoGiocatore() : Giocatore
    ~eliminaGiocatore(giocatore : Giocatore) : void
