@startuml
title UnoLegends - class diagram del model
skinparam classAttributeIconSize 0
hide empty members
scale max 7600 width

package "unolegends.model" {
  class Carta <<final>> {
    -colore : Colore
    -valore : ValoreCarta
    -effetto : Ieffetto
    +Carta(colore : Colore, valore : ValoreCarta, effetto : Ieffetto)
    +Carta(colore : Colore, valore : ValoreCarta)
    +getColore() : Colore
    +getValoreCarta() : ValoreCarta
    +getEffetto() : Ieffetto
    +toTestoBase() : String
    +getDescrizioneBreve() : String
    +getDescrizioneBreve(coloreVisualizzato : Colore) : String
  }

  note right of Carta
    Unica classe di carta: il comportamento
    varia solo tramite l'Ieffetto (Strategy).
    Le numeriche usano Effetto_Nullo (Null Object).
    Sostituisce CartaNumero e CartaSpeciale.
  end note

  class Giocatore {
    -nome : String
    -mano : List<Carta>
    -stato : StatoGiocatore
    +Giocatore(nome : String, manoIniziale : List<Carta>)
    +getNome() : String
    +getStato() : StatoGiocatore
    +isInGioco() : boolean
    ~segnaComeTerminato() : void
    ~segnaComeEliminato() : void
    ~svuotaMano() : List<Carta>
    ~riceviCarte(carte : List<Carta>) : void
    +getMano() : List<Carta>
    +getCartaInPosizione(indiceCarta : int) : Carta
    +estraiCarta(indiceCarta : int) : Carta
    +rimuoviCarta(carta : Carta) : boolean
    +aggiungiCarta(carta : Carta) : void
  }

  enum StatoGiocatore {
    IN_GIOCO
    TERMINATO
    ELIMINATO
  }

  class Mazzo {
    -carte : Deque<Carta>
    +Mazzo(carteIniziali : Collection<Carta>)
    +prelevaCarta() : Carta
    +isVuoto() : boolean
    +getNumeroCarteRestanti() : int
    +mischia() : void
    +rimescolaDaScarti(pilaDegliScarti : PilaDegliScarti) : void
    +aggiungiCarteERimescola(nuoveCarte : Collection<Carta>) : void
  }

  class PilaDegliScarti {
    -scarti : List<Carta>
    +PilaDegliScarti(scartiIniziali : List<Carta>)
    +getCartaInCima() : Carta
    +aggiungiCarta(carta : Carta) : void
    +estraiCartePerRimescolamento() : List<Carta>
    +inserisciSottoLaCima(carte : List<Carta>) : void
  }

  class Partita {
