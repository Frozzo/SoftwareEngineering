  }

  enum FaseTurno {
    NORMALE
    POST_PESCA
    ATTESA_INPUT
    ATTESA_UNO
    TERMINATA
  }

  class AzioneInAttesa <<record>> {
    +effetto : Ieffetto
    +completamento : Consumer<String>
  }

  enum TipoEvento {
    PESCA_VOLONTARIA
    PESCA_FORZATA
    TURNO_SALTATO
    SENSO_INVERTITO
    COLORE_SCELTO
    UNO_DICHIARATO
    GIOCATORE_TERMINATO
    GIOCATORE_ELIMINATO
    MANI_SCAMBIATE
    MANI_PASSATE
    CARTE_SCARTATE
    TURNO_EXTRA
  }

  class EventoPartita <<record>> {
    +tipo : TipoEvento
    +nomeGiocatore : String
    +quantita : int
    +origine : OriginePesca
    +colore : Colore
    +altroGiocatore : String
  }

  class RegoleDiGioco {
    -strategiaVittoria : IStrategiaCondizioneVittoria
    -strategiaSconfitta : IStrategiaCondizioneSconfitta
    -strategiaCompatibilitaCarte : IStrategiaCompatibilitaCarte
    -strategiaPescaVolontaria : IStrategiaPesca
    -strategiaPenalitaUno : IStrategiaPenalitaUno
    -strategiaFinePartita : IStrategiaFinePartita
    +RegoleDiGioco(strategiaVittoria : IStrategiaCondizioneVittoria, strategiaSconfitta : IStrategiaCondizioneSconfitta, strategiaCompatibilitaCarte : IStrategiaCompatibilitaCarte, strategiaPescaVolontaria : IStrategiaPesca, strategiaPenalitaUno : IStrategiaPenalitaUno, strategiaFinePartita : IStrategiaFinePartita)
    +isGiocabile(giocatore : Giocatore, candidata : Carta, inCima : Carta, partita : Partita) : boolean
    +isVincitore(giocatore : Giocatore, partita : Partita) : boolean
    +isEliminato(giocatore : Giocatore, partita : Partita) : boolean
    +isPartitaTerminata(partita : Partita) : boolean
    +pescaVolontaria(giocatore : Giocatore, partita : Partita) : List<Carta>
    +calcolaCartePescaForzata(contesto : ContestoPesca) : int
    +mancatoUno(giocatore : Giocatore, unoDichiarato : boolean, partita : Partita) : boolean
    +{static} standard() : RegoleDiGioco
    +{static} standard(opzioni : Set<OpzionePartita>) : RegoleDiGioco
    +{static} noMercy(opzioni : Set<OpzionePartita>) : RegoleDiGioco
    +{static} SOGLIA_ELIMINAZIONE_NO_MERCY : int
  }

  interface Ieffetto {
    +attivaEffetto(partita : Partita) : void
    +{default} getRichiestaInput(partita : Partita) : RichiestaInput
    +{default} validaRispostaInput(risposta : String, partita : Partita) : boolean
    +{default} attivaEffetto(partita : Partita, risposta : String) : void
    +{default} isAmmessoComeCartaIniziale() : boolean
  }

  class Effetto_Nullo {
    +attivaEffetto(partita : Partita) : void
  }

  class Effetto_Cambia_colore {
    +attivaEffetto(partita : Partita) : void
    +getRichiestaInput(partita : Partita) : RichiestaInput
    +validaRispostaInput(risposta : String, partita : Partita) : boolean
    +attivaEffetto(partita : Partita, risposta : String) : void
    -{static} coloreDaRisposta(risposta : String) : Colore
  }

  class Effetto_pescata_carte {
    -numeroCarteDaPescare : int
    -origine : OriginePesca
    +Effetto_pescata_carte(numeroCarteDaPescare : int, origine : OriginePesca)
    +attivaEffetto(partita : Partita) : void
  }

  class Effetto_Blocca_Turno {
    +attivaEffetto(partita : Partita) : void
  }

  class Effetto_cambio_giro {
    +attivaEffetto(partita : Partita) : void
  }

  class EffettoScambiaMano {
    +getRichiestaInput(partita : Partita) : RichiestaInput
    +validaRispostaInput(risposta : String, partita : Partita) : boolean
    +attivaEffetto(partita : Partita, risposta : String) : void
    +isAmmessoComeCartaIniziale() : boolean
  }

  class EffettoPassaMani {
    +attivaEffetto(partita : Partita) : void
    +isAmmessoComeCartaIniziale() : boolean
  }

  class EffettoScartaColore {
    +attivaEffetto(partita : Partita) : void
    +isAmmessoComeCartaIniziale() : boolean
  }

  class EffettoTurnoExtra {
    +attivaEffetto(partita : Partita) : void
    +isAmmessoComeCartaIniziale() : boolean
  }

  class EffettoRoulette {
    -sceltaColore : Effetto_Cambia_colore
    +getRichiestaInput(partita : Partita) : RichiestaInput
    +validaRispostaInput(risposta : String, partita : Partita) : boolean
    +attivaEffetto(partita : Partita, risposta : String) : void
  }

  class EffettoComposito {
    -effetti : List<Ieffetto>
    +EffettoComposito(effetti : List<Ieffetto>)
    -{static} contaEffettiConInput(effetti : List<Ieffetto>) : int
    +attivaEffetto(partita : Partita) : void
    +getRichiestaInput(partita : Partita) : RichiestaInput
    +validaRispostaInput(risposta : String, partita : Partita) : boolean
    +attivaEffetto(partita : Partita, risposta : String) : void
    +{static} contieneEffetto(effetto : Ieffetto, tipoEffetto : Class<? extends Ieffetto>) : boolean
  }

  enum OriginePesca {
    VOLONTARIA
    PIU_DUE
    PIU_QUATTRO
    PENALITA_UNO
    PIU_SEI
    PIU_DIECI
    ROULETTE
  }

  class ContestoPesca <<record>> {
    +bersaglio : Giocatore
    +numeroCarte : int
    +origine : OriginePesca
  }

  enum TipoRichiesta {
    SCELTA_COLORE
    SCELTA_GIOCATORE
  }

  class RichiestaInput {
    -tipo : TipoRichiesta
    -opzioni : List<String>
    +RichiestaInput(tipo : TipoRichiesta, opzioni : List<String>)
    +getTipo() : TipoRichiesta
    +getOpzioni() : List<String>
  }

  interface MazzoFactory {
    +creaMazzo() : Mazzo
  }

  class NoMercyMazzoFactory {
    -{static} INSTANCE : NoMercyMazzoFactory
    +{static} NUMERO_CARTE : int
    -NoMercyMazzoFactory()
    +{static} getInstance() : NoMercyMazzoFactory
    +creaMazzo() : Mazzo
  }

  class StandardMazzoFactory {
    -{static} INSTANCE : StandardMazzoFactory
    -StandardMazzoFactory()
    +{static} getInstance() : StandardMazzoFactory
    +creaMazzo() : Mazzo
  }

  class PartitaFactory {
    -{static} CARTE_PER_GIOCATORE : int
    +{static} creaPartita(config : ConfigurazionePartita) : Partita
    +{static} creaPartita(mazzoFactory : MazzoFactory, nomiGiocatori : List<String>, regole : RegoleDiGioco) : Partita
    -{static} creaRegole(config : ConfigurazionePartita) : RegoleDiGioco
    -{static} distribuisciCarteAiGiocatori(mazzo : Mazzo, nomiGiocatori : List<String>) : List<Giocatore>
  }

  enum ModalitaDiGioco {
    NORMALE
    NO_MERCY
    --
    -mazzoFactory : MazzoFactory
    -opzioniObbligatorie : Set<OpzionePartita>
    +getMazzoFactory() : MazzoFactory
    +getOpzioniObbligatorie() : Set<OpzionePartita>
    +isConfigurabile(opzione : OpzionePartita) : boolean
  }

  enum OpzionePartita {
    ENDLESS
  }

  class ConfigurazionePartita <<record>> {
    +modalita : ModalitaDiGioco
    +nomiGiocatori : List<String>
    +opzioni : Set<OpzionePartita>
    +{static} MIN_GIOCATORI : int
    +{static} MAX_GIOCATORI : int
    +{static} MIN_GIOCATORI_ENDLESS : int
    +{static} verifica(modalita : ModalitaDiGioco, nomiGiocatori : List<String>, opzioni : Set<OpzionePartita>) : ErroreConfigurazione
    +haOpzione(opzione : OpzionePartita) : boolean
    +numeroGiocatori() : int
  }

  enum ErroreConfigurazione {
    NUMERO_GIOCATORI_NON_VALIDO
    NOME_VUOTO
    NOMI_DUPLICATI
    GIOCATORI_INSUFFICIENTI_PER_ENDLESS
  }


  enum Colore {
    ROSSO
    VERDE
    BLU
    GIALLO
    NERO
    --
    -{static} ANSI_RESET : String
    -nome : String
    -ansiCode : String
    -Colore(nome : String, ansiCode : String)
    +getNome() : String
    +formatta(testo : String) : String
  }

  enum ValoreCarta {
    ZERO
    UNO
    DUE
    TRE
    QUATTRO
    CINQUE
    SEI
    SETTE
    OTTO
    NOVE
    PIU_DUE
    BLOCCA_TURNO
    CAMBIA_GIRO
    CAMBIA_COLORE
    PIU_QUATTRO
    SCARTA_TUTTO
    SALTA_TUTTI
    CAMBIO_GIRO_PIU_QUATTRO
    PIU_SEI
    PIU_DIECI
    ROULETTE
    --
    -valore : String
    -ValoreCarta(valore : String)
    +getValore() : String
    +{static} fromInt(numero : int) : ValoreCarta
    +{static} fromString(testo : String) : ValoreCarta
  }
}

Ieffetto <|.. Effetto_Nullo
Ieffetto <|.. Effetto_Cambia_colore
Ieffetto <|.. Effetto_pescata_carte
Ieffetto <|.. Effetto_Blocca_Turno
Ieffetto <|.. Effetto_cambio_giro
Ieffetto <|.. EffettoComposito
MazzoFactory <|.. StandardMazzoFactory
MazzoFactory <|.. NoMercyMazzoFactory
Ieffetto <|.. EffettoScambiaMano
Ieffetto <|.. EffettoPassaMani
Ieffetto <|.. EffettoScartaColore
Ieffetto <|.. EffettoTurnoExtra
Ieffetto <|.. EffettoRoulette
EffettoRoulette --> "1" Effetto_Cambia_colore : sceltaColore
NoMercyMazzoFactory ..> Carta : crea
ModalitaDiGioco ..> NoMercyMazzoFactory : NO_MERCY

Carta --> "1" Colore
Carta --> "1" ValoreCarta
Carta --> "1" Ieffetto : effetto
EffettoComposito --> "1..*" Ieffetto : effetti
Effetto_Cambia_colore ..> RichiestaInput : crea

Giocatore "1" --> "0..*" Carta : mano
Mazzo "1" --> "0..*" Carta : carte
PilaDegliScarti "1" --> "0..*" Carta : scarti
Partita "1" --> "1..*" Giocatore : giocatori
Partita "1" --> "1" Mazzo : mazzo
Partita "1" --> "1" PilaDegliScarti : pilaDegliScarti
Partita "1" --> "1" RegoleDiGioco : regole
Partita "1" --> "0..1" Carta : cartaAppenaPescata
Partita "1" --> "1" FaseTurno : fase
Partita "1" --> "0..1" AzioneInAttesa : azioneInAttesa
Partita "1" --> "0..*" EventoPartita : eventi
AzioneInAttesa --> "1" Ieffetto : effetto
EventoPartita --> "1" TipoEvento : tipo
EventoPartita --> "0..1" OriginePesca : origine
EventoPartita --> "0..1" Colore : colore
Partita "1" --> "0..*" Giocatore : classifica
Giocatore --> "1" StatoGiocatore : stato
ModalitaDiGioco --> "1" MazzoFactory : mazzoFactory
ModalitaDiGioco --> "0..*" OpzionePartita : opzioniObbligatorie
ConfigurazionePartita --> "1" ModalitaDiGioco : modalita
ConfigurazionePartita --> "0..*" OpzionePartita : opzioni
ConfigurazionePartita ..> ErroreConfigurazione : verifica restituisce
PartitaFactory ..> ConfigurazionePartita : traduce
RegoleDiGioco ..> OpzionePartita : sceglie le strategie
Partita "1" --> "0..1" Colore : coloreAttuale
RichiestaInput --> "1" TipoRichiesta : tipo

PartitaFactory ..> MazzoFactory : usa
PartitaFactory ..> RegoleDiGioco : configura
PartitaFactory ..> Partita : crea
PartitaFactory ..> Giocatore : crea
StandardMazzoFactory ..> Mazzo : crea
StandardMazzoFactory ..> Carta : crea
Mazzo ..> PilaDegliScarti : rimescola da scarti
Effetto_pescata_carte ..> Partita : pesca e salta turno
Effetto_pescata_carte --> "1" OriginePesca : origine
ContestoPesca --> "1" Giocatore : bersaglio
ContestoPesca --> "1" OriginePesca : origine
Partita ..> ContestoPesca : crea
RegoleDiGioco ..> ContestoPesca : usa
Effetto_Blocca_Turno ..> Partita : segnala salto turno
Effetto_cambio_giro ..> Partita : cambia giro
Effetto_Cambia_colore ..> Partita : applica colore

note right of RegoleDiGioco
  Le interfacce IStrategia* (compresa IStrategiaFinePartita:
  StrategiaFinePartitaStandard / StrategiaFinePartitaEndless)
  sono dichiarate nel package
  unolegends.domain.rules, esterno al model, e qui sono
  riportate come tipi degli attributi senza espanderne
  le classi.
end note
@enduml
