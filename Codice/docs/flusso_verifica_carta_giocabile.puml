@startuml
title UNO Legends - Verifica giocata e interazione richiesta dall'effetto

|Utente|
start
:Sceglie "gioca carta";

|UnoLegendsCli|
:Raccoglie l'indice;
:Invoca UnoLegendsGame.giocaCarta(indice, null, unoDichiarato);

|UnoLegendsGame|
:Inoltra il tentativo a Partita;

|Partita|
if (Partita terminata o input iniziale in attesa?) then (si)
  :Restituisce giocata non completata;
  stop
endif

:Chiede la carta al giocatore attivo;
if (Carta presente e giocabile?) then (no)
  :Restituisce giocata non completata;
  stop
endif

:Richiede all'effetto l'eventuale input;
if (Input richiesto?) then (si)
  :Restituisce EsitoGiocata con RichiestaInput;
  |UnoLegendsGame|
  :Inoltra RichiestaInput alla UI;
  |UnoLegendsCli|
  :Mostra messaggio/opzioni genericamente;
  :Raccoglie la risposta;
  :Ritenta la giocata con la risposta;
  |UnoLegendsGame|
  :Inoltra la risposta;
  |Partita|
  :Delega all'effetto la validazione della risposta;
  if (Risposta valida?) then (no)
    :Restituisce la stessa RichiestaInput;
    |UnoLegendsCli|
    :Ripete la richiesta;
    stop
  endif
endif

|Partita|
:Estrae la carta dalla mano;
:Aggiunge la carta agli scarti;
:Attiva l'effetto con la risposta ricevuta;
:Verifica vittoria e penalità UNO;
:Aggiorna il turno se la partita continua;

|UnoLegendsGame|
:Restituisce EsitoGiocata completato;

|UnoLegendsCli|
:Mostra l'esito all'utente;
stop
@enduml
