@startuml
title Flusso di una carta il cui effetto richiede un input

start
:Il giocatore seleziona una carta;
:La View invia indice e dichiarazione UNO al Controller;
:Il Controller inoltra il tentativo a Partita;

if (Partita terminata o input iniziale ancora pendente?) then (si)
  :EsitoGiocata.completata(false);
  :La View comunica che la mossa non e valida;
  stop
endif

:Partita ottiene carta e giocatore attivi;
if (Carta assente o diversa dalla carta appena pescata?) then (si)
  :EsitoGiocata.completata(false);
  :La View comunica che la mossa non e valida;
  stop
endif

:Partita verifica la compatibilita tramite RegoleDiGioco;
if (Carta non giocabile?) then (si)
  :EsitoGiocata.completata(false);
  :La View comunica che la mossa non e valida;
  stop
endif

:Partita interroga l'effetto con getRichiestaInput();
if (Effetto non richiede input?) then (si)
  :Partita prosegue direttamente con la giocata;
else (no)
  :Partita restituisce EsitoGiocata.inAttesa(RichiestaInput);
  :Controller inoltra la richiesta alla View;
  :La View mostra messaggio e opzioni;\nnon conosce il tipo concreto di effetto;
  :Il giocatore fornisce la risposta;
  :La View la inoltra al Controller;
  :Il Controller ritenta la giocata\ncon indice, risposta e dichiarazione UNO;
  :Partita verifica la risposta tramite l'effetto;
  while (Risposta non valida?) is (si)
    :La stessa RichiestaInput viene restituita alla View;
    :La View la mostra e raccoglie una nuova risposta;
    :Controller e Partita inoltrano il nuovo tentativo;
    :L'effetto valida nuovamente la risposta;
  endwhile (no)
endif

:Partita rimuove la carta dalla mano\ne la aggiunge agli scarti;
:Partita attiva l'effetto con la risposta;
:Partita applica l'eventuale penalita UNO;
:Partita controlla la vittoria e aggiorna il turno;
:Controller restituisce EsitoGiocata.completata(true);
:La View comunica che la carta e stata giocata;
stop
@enduml

@startuml
title System Sequence Diagram - Richieste di input degli effetti
autonumber

actor "Giocatore" as Utente
participant "UnoLegendsCli\n(View)" as View
participant "UnoLegendsGame\n(Controller)" as Controller
participant "Partita\n(Coordinator)" as Partita
participant "Giocatore\n(Entita di dominio)" as Giocatore
participant "Carta" as Carta
participant "RegoleDiGioco" as Regole
participant "PilaDegliScarti" as Scarti
participant "Ieffetto" as Effetto
participant "CartaSpeciale" as CartaSpeciale
participant "EffettoComposito\n(se presente)" as Composto
participant "Effetto_Cambia_colore\n(esempio)" as EffettoColore
participant "RichiestaInput" as Richiesta
participant "EsitoGiocata" as Esito
participant "StatoPartita" as Stato
participant "PartitaFactory\n(solo setup iniziale)" as Factory

== Giocata di una carta che richiede input ==
Utente -> View : Seleziona carta e dichiara eventualmente UNO
View -> Controller : giocaCarta(indice, null, unoDichiarato)
Controller -> Partita : giocaCarta(indice, unoDichiarato, null)
Partita -> Giocatore : getCartaInPosizione(indice)
Giocatore --> Partita : carta selezionata
Partita -> Scarti : getCartaInCima()
Scarti --> Partita : carta in cima
Partita -> Regole : isGiocabile(carta, cartaInCima)
Regole --> Partita : giocabile
Partita -> Carta : getEffetto()
Carta --> Partita : effetto

opt la carta usa un EffettoComposito
    Partita -> Composto : getRichiestaInput()
    Composto -> EffettoColore : getRichiestaInput()\n(cerca l'effetto componente che richiede input)
    EffettoColore --> Composto : richiesta o null
    Composto --> Partita : richiesta
end

opt effetto semplice
    Partita -> Effetto : getRichiestaInput()
    Effetto --> Partita : RichiestaInput o null
end

alt l'effetto non richiede input
    Partita -> Giocatore : estraiCarta(indice)
    Giocatore --> Partita : carta giocata
    Partita -> Scarti : aggiungiCarta(carta)
    Partita -> Effetto : attivaeffetto(partita, null)
    Partita --> Controller : EsitoGiocata.completata(true)
    Controller --> View : esito giocata
    View --> Utente : Mostra esito
else l'effetto richiede input
    Partita -> Esito : inAttesa(richiesta)
    Esito --> Partita : esito con RichiestaInput
    Partita --> Controller : EsitoGiocata
    Controller --> View : RichiestaInput
    View -> Richiesta : getMessaggio() e getOpzioni()
    Richiesta --> View : testo e opzioni
    View --> Utente : Mostra richiesta
    Utente -> View : Inserisce/seleziona risposta
    View -> Controller : giocaCarta(indice, risposta, unoDichiarato)
    Controller -> Partita : giocaCarta(indice, unoDichiarato, risposta)
    Partita -> Giocatore : getCartaInPosizione(indice)
    Giocatore --> Partita : carta selezionata
    Partita -> Regole : isGiocabile(carta, cartaInCima)
    Regole --> Partita : giocabile
    Partita -> Carta : getEffetto()
    Carta --> Partita : effetto

    opt la carta usa un EffettoComposito
        Partita -> Composto : validaRispostaInput(risposta)
        Composto -> EffettoColore : validaRispostaInput(risposta)
        EffettoColore --> Composto : valida
        Composto --> Partita : valida
    end

    opt effetto semplice
        Partita -> Effetto : validaRispostaInput(risposta)
        Effetto --> Partita : valida
    end

    alt risposta non valida
        Partita -> Esito : inAttesa(stessa richiesta)
        Esito --> Partita : esito con richiesta
        Partita --> Controller : EsitoGiocata
        Controller --> View : richiesta da mostrare di nuovo
        View --> Utente : Mostra messaggio e opzioni
    else risposta valida
        Partita -> Giocatore : estraiCarta(indice)
        Giocatore --> Partita : carta giocata
        Partita -> Scarti : aggiungiCarta(carta)
        Partita -> Effetto : attivaeffetto(partita, risposta)
        opt effetto composto con componente interattivo
            Effetto -> Composto : inoltra risposta al componente
            Composto -> EffettoColore : attivaeffetto(partita, risposta)
        end
        opt esempio: Effetto_Cambia_colore
            EffettoColore -> Partita : applicaColoreScelto(colore)
            Partita -> Scarti : getCartaInCima()
            Scarti --> Partita : carta speciale in cima
            Partita -> CartaSpeciale : setColore(colore)
        end
        Partita -> Regole : applica eventuale penalita UNO\npoi isVincitore(...)
        Regole --> Partita : esito regole
        Partita -> Partita : aggiornaGiocatoreAttivo()\nse la partita continua
        Partita -> Esito : completata(true)
        Esito --> Partita : esito completato
        Partita --> Controller : EsitoGiocata
        Controller --> View : esito giocata
        View --> Utente : Mostra esito
    end
end

== Input richiesto dall'effetto della carta iniziale ==
note over Factory, Partita
    In costruzione, PartitaFactory lascia in attesa
    una carta iniziale il cui effetto dichiara una richiesta.
end note
Factory -> Partita : <<create>> Partita(..., carta iniziale)
Utente -> View : Avvia/continua la partita
View -> Controller : richiediStato()
Controller -> Partita : getRichiestaInputIniziale()
Partita -> Effetto : getRichiestaInput()
Effetto --> Partita : RichiestaInput
Partita --> Controller : RichiestaInput
Controller -> Stato : crea snapshot con richiesta iniziale
Stato --> Controller : StatoPartita
Controller --> View : StatoPartita
View -> Richiesta : getMessaggio() e getOpzioni()
Richiesta --> View : testo e opzioni
View --> Utente : Mostra richiesta
Utente -> View : Inserisce/seleziona risposta
View -> Controller : rispondiRichiestaInputIniziale(risposta)
Controller -> Partita : rispondiRichiestaInputIniziale(risposta)
Partita -> Effetto : validaRispostaInput(risposta)
Effetto --> Partita : valida
alt risposta valida
    Partita -> Effetto : attivaeffetto(partita, risposta)
    opt esempio: cambio colore
        Effetto -> Partita : applicaColoreScelto(colore)
        Partita -> CartaSpeciale : setColore(colore della carta in cima)
    end
    Partita --> Controller : true
    Controller --> View : risposta accettata
else risposta non valida
    Partita --> Controller : false
    Controller --> View : risposta rifiutata
    View --> Utente : Ripresenta la richiesta
end

note over Utente, Effetto
    L'effetto dichiara, valida e applica l'input.
    Controller e View inoltrano richiesta e risposta;
    la View presenta il messaggio e le opzioni senza
    conoscere il tipo concreto dell'effetto.
end note
@enduml
