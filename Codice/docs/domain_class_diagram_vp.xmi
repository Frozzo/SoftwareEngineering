<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://www.omg.org/XMI" xmlns:uml="http://www.omg.org/spec/UML/20090901" xmlns:vp="http://www.visual-paradigm.com">
  <xmi:Documentation exporter="Visual Paradigm" exporterVersion="16.2"/>
  <uml:Model xmi:id="model_unolegends_vp" name="UnoLegendsModel_VP">

    <!-- Visual Paradigm extension -->
    <xmi:Extension extender="Visual Paradigm" extenderID="VP"/>

    <!-- Classes and Interface -->
    <packagedElement xmi:type="uml:Class" xmi:id="class_carta_vp" name="Carta">
      <ownedAttribute xmi:id="attr_carta_id_vp" name="id" visibility="private"/>
      <ownedOperation xmi:id="op_carta_getId_vp" name="getId" visibility="public"/>
      <ownedOperation xmi:id="op_carta_compatibileCon_vp" name="compatibileCon" visibility="public">
        <ownedParameter xmi:id="param_compatibileCon_cartaInCima" name="cartaInCima"/>
      </ownedOperation>
      <ownedOperation xmi:id="op_carta_toCliString_vp" name="toCliString" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_cartanumero_vp" name="CartaNumero">
      <generalization xmi:id="gen_cartanumero_carta_vp" general="class_carta_vp"/>
      <ownedAttribute xmi:id="attr_cartanumero_colore_vp" name="colore" visibility="private"/>
      <ownedAttribute xmi:id="attr_cartanumero_numero_vp" name="numero" visibility="private"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_cartaspeciale_vp" name="CartaSpeciale">
      <generalization xmi:id="gen_cartaspeciale_carta_vp" general="class_carta_vp"/>
      <ownedAttribute xmi:id="attr_cartaspeciale_tipo_vp" name="tipo" visibility="private"/>
      <ownedAttribute xmi:id="attr_cartaspeciale_attributi_vp" name="attributi" visibility="private"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="interface_regole_vp" name="RegoleDiGioco">
      <ownedOperation xmi:id="op_regole_isGiocabile_vp" name="isGiocabile" visibility="public">
        <ownedParameter xmi:id="param_isGiocabile_candidata" name="candidata"/>
        <ownedParameter xmi:id="param_isGiocabile_inCima" name="inCima"/>
        <ownedParameter xmi:id="param_isGiocabile_partita" name="partita"/>
      </ownedOperation>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_regolestandard_vp" name="RegoleStandard">
      <ownedOperation xmi:id="op_regolestd_isGiocabile_vp" name="isGiocabile" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_giocatore_vp" name="Giocatore">
      <ownedAttribute xmi:id="attr_giocatore_nome_vp" name="nome" visibility="private"/>
      <ownedOperation xmi:id="op_giocatore_aggiungi_vp" name="aggiungiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_giocatore_estrai_vp" name="estraiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_giocatore_getCarta_vp" name="getCartaInPosizione" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_mazzo_vp" name="Mazzo">
      <ownedOperation xmi:id="op_mazzo_preleva_vp" name="prelevaCarta" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_pila_vp" name="PilaDegliScarti">
      <ownedOperation xmi:id="op_pila_aggiungi_vp" name="aggiungiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_pila_get_vp" name="getCartaInCima" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_partita_vp" name="Partita">
      <ownedAttribute xmi:id="attr_partita_turno_vp" name="turnoCorrente" visibility="private"/>
      <ownedOperation xmi:id="op_partita_getStato_vp" name="getStatoTurno" visibility="public"/>
      <ownedOperation xmi:id="op_partita_gioca_vp" name="giocaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_partita_pesca_vp" name="pescaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_partita_passa_vp" name="passaTurno" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_partitafactory_vp" name="PartitaFactory">
      <ownedOperation xmi:id="op_pf_creaStandard_vp" name="creaPartitaStandard" visibility="public"/>
      <ownedOperation xmi:id="op_pf_crea_vp" name="creaPartita" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_mazzofactory_vp" name="MazzoFactory" isAbstract="true">
      <ownedOperation xmi:id="op_mf_getCarte_vp" name="getCarteNormali" visibility="public"/>
      <ownedOperation xmi:id="op_mf_creaMazzo_vp" name="creaMazzo" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_standardmazzofactory_vp" name="StandardMazzoFactory">
      <generalization xmi:id="gen_std_mf_vp" general="class_mazzofactory_vp"/>
      <ownedAttribute xmi:id="attr_std_instance_vp" name="instance" visibility="private"/>
      <ownedOperation xmi:id="op_std_getInstance_vp" name="getInstance" visibility="public"/>
      <ownedOperation xmi:id="op_std_getCarte_vp" name="getCarteNormali" visibility="public"/>
      <ownedOperation xmi:id="op_std_creaMazzo_vp" name="creaMazzo" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_unolegendsgame_vp" name="UnoLegendsGame">
      <ownedOperation xmi:id="op_game_richiedi_vp" name="richiediStato" visibility="public"/>
      <ownedOperation xmi:id="op_game_gioca_vp" name="giocaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_game_pesca_vp" name="pescaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_game_passa_vp" name="passaTurno" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_statoturno_vp" name="StatoTurno">
      <ownedAttribute xmi:id="attr_stato_nome_vp" name="nomeGiocatoreAttivo" visibility="private"/>
      <ownedAttribute xmi:id="attr_stato_deve_vp" name="deveGiocareCartaPescata" visibility="private"/>
    </packagedElement>

    <!-- Realizations -->
    <packagedElement xmi:type="uml:Realization" xmi:id="real_regoleimpl_vp" name="RegoleStandardRealizesRegoleDiGioco">
      <client xmi:idref="class_regolestandard_vp"/>
      <supplier xmi:idref="interface_regole_vp"/>
    </packagedElement>

    <!-- Associations with multiplicities -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_giocatore_mano_vp" name="Giocatore_mano">
      <ownedEnd xmi:id="end_giocatore_mano_vp_1" type="class_giocatore_vp" name="giocatore">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_giocatore" value="1"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="upper_giocatore" value="1"/>
      </ownedEnd>
      <ownedEnd xmi:id="end_giocatore_mano_vp_2" type="class_carta_vp" name="mano">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_mano" value="0"/>
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="upper_mano" value="*"/>
      </ownedEnd>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_giocatori_vp" name="Partita_giocatori">
      <ownedEnd xmi:id="end_partita_gioc_vp_1" type="class_partita_vp" name="partita">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_partita" value="1"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_partita" value="1"/>
      </ownedEnd>
      <ownedEnd xmi:id="end_partita_gioc_vp_2" type="class_giocatore_vp" name="giocatori">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_giocatori" value="2"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_giocatori" value="4"/>
      </ownedEnd>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_mazzo_vp" name="Partita_mazzo">
      <ownedEnd xmi:id="end_partita_mazzo_vp_1" type="class_partita_vp" name="partita">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_partita_mazzo" value="1"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_partita_mazzo" value="1"/>
      </ownedEnd>
      <ownedEnd xmi:id="end_partita_mazzo_vp_2" type="class_mazzo_vp" name="mazzo">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_mazzo" value="1"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_mazzo" value="1"/>
      </ownedEnd>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_scarti_vp" name="Partita_scarti">
      <ownedEnd xmi:id="end_partita_scarti_vp_1" type="class_partita_vp" name="partita"/>
      <ownedEnd xmi:id="end_partita_scarti_vp_2" type="class_pila_vp" name="scarti"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_regole_vp" name="Partita_regole">
      <ownedEnd xmi:id="end_partita_regole_vp_1" type="class_partita_vp" name="partita"/>
      <ownedEnd xmi:id="end_partita_regole_vp_2" type="interface_regole_vp" name="regole"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_game_partita_vp" name="Game_partita">
      <ownedEnd xmi:id="end_game_partita_vp_1" type="class_unolegendsgame_vp" name="game">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_game" value="1"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_game" value="1"/>
      </ownedEnd>
      <ownedEnd xmi:id="end_game_partita_vp_2" type="class_partita_vp" name="partita">
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="lower_game_partita" value="1"/>
        <upperValue xmi:type="uml:LiteralInteger" xmi:id="upper_game_partita" value="1"/>
      </ownedEnd>
    </packagedElement>

    <!-- StatoTurno associations to Carta -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_mano_vp" name="Stato_mano">
      <ownedEnd xmi:id="end_stato_mano_vp_1" type="class_statoturno_vp" name="stato"/>
      <ownedEnd xmi:id="end_stato_mano_vp_2" type="class_carta_vp" name="manoGiocatoreAttivo"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_inCima_vp" name="Stato_cartaInCima">
      <ownedEnd xmi:id="end_stato_inCima_vp_1" type="class_statoturno_vp" name="stato"/>
      <ownedEnd xmi:id="end_stato_inCima_vp_2" type="class_carta_vp" name="cartaInCima"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_appena_vp" name="Stato_cartaAppenaPescata">
      <ownedEnd xmi:id="end_stato_appena_vp_1" type="class_statoturno_vp" name="stato"/>
      <ownedEnd xmi:id="end_stato_appena_vp_2" type="class_carta_vp" name="cartaAppenaPescata"/>
    </packagedElement>

    <!-- Comments -->
    <packagedElement xmi:type="uml:Comment" xmi:id="note_design_vp" body="Design notes: Sintassi UML standard applicata per attributi e metodi. RegoleDiGioco è un'interfaccia Strategy; RegoleStandard è l'implementazione predefinita. StandardMazzoFactory è singleton che fornisce il catalogo. PartitaFactory è Factory/Creator per la startup. UnoLegendsGame è Facade/Controller."/>

  </uml:Model>
</xmi:XMI>
