<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://www.omg.org/XMI" xmlns:uml="http://www.omg.org/spec/UML/20090901">
  <uml:Model xmi:id="model_unolegends" name="UnoLegendsModel">

    <!-- Classes and Interface -->
    <packagedElement xmi:type="uml:Class" xmi:id="class_carta" name="Carta">
      <ownedAttribute xmi:id="attr_carta_id" name="id" visibility="private"/>
      <ownedOperation xmi:id="op_carta_getId" name="getId" visibility="public"/>
      <ownedOperation xmi:id="op_carta_compatibileCon" name="compatibileCon" visibility="public"/>
      <ownedOperation xmi:id="op_carta_toCliString" name="toCliString" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_cartanumero" name="CartaNumero">
      <generalization xmi:id="gen_cartanumero_carta" general="class_carta"/>
      <ownedAttribute xmi:id="attr_cartanumero_colore" name="colore" visibility="private"/>
      <ownedAttribute xmi:id="attr_cartanumero_numero" name="numero" visibility="private"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_cartaspeciale" name="CartaSpeciale">
      <generalization xmi:id="gen_cartaspeciale_carta" general="class_carta"/>
      <ownedAttribute xmi:id="attr_cartaspeciale_tipo" name="tipo" visibility="private"/>
      <ownedAttribute xmi:id="attr_cartaspeciale_attributi" name="attributi" visibility="private"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="interface_regole" name="RegoleDiGioco">
      <ownedOperation xmi:id="op_regole_isGiocabile" name="isGiocabile" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_regolestandard" name="RegoleStandard">
      <!-- Realization represented as Dependency -->
      <ownedOperation xmi:id="op_regolestd_isGiocabile" name="isGiocabile" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_giocatore" name="Giocatore">
      <ownedAttribute xmi:id="attr_giocatore_nome" name="nome" visibility="private"/>
      <ownedOperation xmi:id="op_giocatore_aggiungi" name="aggiungiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_giocatore_estrai" name="estraiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_giocatore_getCarta" name="getCartaInPosizione" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_mazzo" name="Mazzo">
      <ownedOperation xmi:id="op_mazzo_preleva" name="prelevaCarta" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_pila" name="PilaDegliScarti">
      <ownedOperation xmi:id="op_pila_aggiungi" name="aggiungiCarta" visibility="public"/>
      <ownedOperation xmi:id="op_pila_get" name="getCartaInCima" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_partita" name="Partita">
      <ownedAttribute xmi:id="attr_partita_turno" name="turnoCorrente" visibility="private"/>
      <ownedOperation xmi:id="op_partita_getStato" name="getStatoTurno" visibility="public"/>
      <ownedOperation xmi:id="op_partita_gioca" name="giocaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_partita_pesca" name="pescaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_partita_passa" name="passaTurno" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_partitafactory" name="PartitaFactory">
      <ownedOperation xmi:id="op_pf_creaStandard" name="creaPartitaStandard" visibility="public"/>
      <ownedOperation xmi:id="op_pf_crea" name="creaPartita" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_mazzofactory" name="MazzoFactory" isAbstract="true">
      <ownedOperation xmi:id="op_mf_getCarte" name="getCarteNormali" visibility="public"/>
      <ownedOperation xmi:id="op_mf_creaMazzo" name="creaMazzo" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_standardmazzofactory" name="StandardMazzoFactory">
      <generalization xmi:id="gen_std_mf" general="class_mazzofactory"/>
      <ownedAttribute xmi:id="attr_std_instance" name="instance" visibility="private"/>
      <ownedOperation xmi:id="op_std_getInstance" name="getInstance" visibility="public"/>
      <ownedOperation xmi:id="op_std_getCarte" name="getCarteNormali" visibility="public"/>
      <ownedOperation xmi:id="op_std_creaMazzo" name="creaMazzo" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_unolegendsgame" name="UnoLegendsGame">
      <ownedOperation xmi:id="op_game_richiedi" name="richiediStato" visibility="public"/>
      <ownedOperation xmi:id="op_game_gioca" name="giocaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_game_pesca" name="pescaCarta" visibility="public"/>
      <ownedOperation xmi:id="op_game_passa" name="passaTurno" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="class_statoturno" name="StatoTurno">
      <ownedAttribute xmi:id="attr_stato_nome" name="nomeGiocatoreAttivo" visibility="private"/>
      <ownedAttribute xmi:id="attr_stato_deve" name="deveGiocareCartaPescata" visibility="private"/>
    </packagedElement>

    <!-- Generalizations and Realizations -->
    <!-- RegoleStandard realizes RegoleDiGioco -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="dep_regole_realize" client="class_regolestandard" supplier="interface_regole"/>

    <!-- Associations (simplified memberEnd approach) -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_giocatore_mano" name="Giocatore_mano">
      <ownedEnd xmi:id="end_giocatore_mano_1" type="class_giocatore" name="owner"/>
      <ownedEnd xmi:id="end_giocatore_mano_2" type="class_carta" name="mano"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_mazzo_contiene" name="Mazzo_contiene">
      <ownedEnd xmi:id="end_mazzo_contiene_1" type="class_mazzo" name="mazzo"/>
      <ownedEnd xmi:id="end_mazzo_contiene_2" type="class_carta" name="contiene"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_pila_scarti" name="Pila_scarti">
      <ownedEnd xmi:id="end_pila_scarti_1" type="class_pila" name="scarti"/>
      <ownedEnd xmi:id="end_pila_scarti_2" type="class_carta" name="contiene"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_giocatori" name="Partita_giocatori">
      <ownedEnd xmi:id="end_partita_gioc_1" type="class_partita" name="partita"/>
      <ownedEnd xmi:id="end_partita_gioc_2" type="class_giocatore" name="giocatori"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_mazzo" name="Partita_mazzo">
      <ownedEnd xmi:id="end_partita_mazzo_1" type="class_partita" name="partita"/>
      <ownedEnd xmi:id="end_partita_mazzo_2" type="class_mazzo" name="mazzo"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_scarti" name="Partita_scarti">
      <ownedEnd xmi:id="end_partita_scarti_1" type="class_partita" name="partita"/>
      <ownedEnd xmi:id="end_partita_scarti_2" type="class_pila" name="scarti"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_partita_regole" name="Partita_regole">
      <ownedEnd xmi:id="end_partita_regole_1" type="class_partita" name="partita"/>
      <ownedEnd xmi:id="end_partita_regole_2" type="interface_regole" name="regole"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_game_partita" name="Game_partita">
      <ownedEnd xmi:id="end_game_partita_1" type="class_unolegendsgame" name="game"/>
      <ownedEnd xmi:id="end_game_partita_2" type="class_partita" name="partita"/>
    </packagedElement>

    <!-- StatoTurno associations to Carta (as separate associations) -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_mano" name="Stato_mano">
      <ownedEnd xmi:id="end_stato_mano_1" type="class_statoturno" name="stato"/>
      <ownedEnd xmi:id="end_stato_mano_2" type="class_carta" name="manoGiocatoreAttivo"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_inCima" name="Stato_cartaInCima">
      <ownedEnd xmi:id="end_stato_inCima_1" type="class_statoturno" name="stato"/>
      <ownedEnd xmi:id="end_stato_inCima_2" type="class_carta" name="cartaInCima"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="assoc_stato_appenaPescata" name="Stato_cartaAppenaPescata">
      <ownedEnd xmi:id="end_stato_appena_1" type="class_statoturno" name="stato"/>
      <ownedEnd xmi:id="end_stato_appena_2" type="class_carta" name="cartaAppenaPescata"/>
    </packagedElement>

    <!-- Notes as comment -->
    <packagedElement xmi:type="uml:Comment" xmi:id="note_design" body="Design notes: Sintassi UML standard applicata per attributi e metodi. RegoleDiGioco è un'interfaccia Strategy; RegoleStandard è l'implementazione predefinita. StandardMazzoFactory è singleton che fornisce il catalogo. PartitaFactory è Factory/Creator per la startup. UnoLegendsGame è Facade/Controller."/>

  </uml:Model>
</xmi:XMI>
